---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SchedulingButton from "../components/SchedulingButton.astro";
import { PROTOTYPES } from "../config/site";
---

<Layout
  title="Prototypes"
  description="Interactive prototypes built from client terms of reference, ready to open and test in the browser."
  path="/prototypes"
>
  <section class="intro">
    <div class="container intro__inner">
      <Eyebrow>Prototypes</Eyebrow>
      <h1 class="intro__heading">Interactive prototypes.</h1>
      <p class="intro__lead">
        Working builds from real terms of reference. Open one in a new tab and click around.
      </p>
    </div>
  </section>

  <section class="prototypes">
    <div class="container">
      <ul class="prototypes-list">
        {PROTOTYPES.map((prototype) => (
          <li class="prototype" data-reveal>
            <h2 class="prototype__title">{prototype.title}</h2>
            <p class="prototype__summary">{prototype.description}</p>
            <p class="prototype__meta">{prototype.meta}</p>
            <p class="prototype__links">
              <a href={prototype.href} target="_blank" rel="noopener noreferrer">
                Open prototype &rarr;
              </a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>Have a terms of reference to build from?</h2>
        <p class="cta-band__line">Book a short call and tell us what you are building.</p>
      </div>
      <SchedulingButton />
    </div>
  </section>
</Layout>

<style>
  .intro {
    padding-block: calc(var(--section-pad) * 0.6) var(--space-16);
  }

  .intro__inner {
    max-width: 42em;
  }

  .intro__heading {
    margin-top: var(--space-5);
  }

  .intro__lead {
    margin-top: var(--space-6);
    font-size: var(--fs-body);
    color: var(--text-muted);
    max-width: 40em;
  }

  .prototypes {
    padding-block: 0 var(--section-pad);
  }

  .prototypes-list {
    display: flex;
    flex-direction: column;
    max-width: 46em;
  }

  .prototype {
    padding-block: var(--space-10);
    border-top: 1px solid var(--border);
  }

  .prototype:last-child {
    border-bottom: 1px solid var(--border);
  }

  .prototype__title {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    font-weight: 400;
    color: var(--text);
    line-height: 1.3;
  }

  .prototype__summary {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: none;
  }

  .prototype__meta {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-subtle);
  }

  .prototype__links {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-4);
  }

  .prototype__links a {
    font-size: var(--fs-small);
    color: var(--accent);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .prototype__links a:hover {
    color: var(--accent-hover);
  }

  .cta-band {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-block: var(--space-20);
  }

  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .cta-band__line {
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .cta-band__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
