---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SchedulingButton from "../components/SchedulingButton.astro";
import {
  GOOGLE_CALENDAR_BOOKING_URL,
  CONTACT_EMAIL,
  PHONE,
  PHONE_HREF,
  SOCIAL,
} from "../config/site";

const socialLinks = [
  { label: "LinkedIn", href: SOCIAL.linkedin },
  { label: "GitHub", href: SOCIAL.github },
  { label: "X", href: SOCIAL.twitter },
].filter((link) => link.href);
---

<Layout
  title="Start a project"
  description="Tell us what you are working on. The fastest way to start is a short call with Sowerved Tech."
  path="/contact"
>
  <section class="contact">
    <div class="container contact__inner">
      <header class="contact__header">
        <Eyebrow>Start a project</Eyebrow>
        <h1 class="contact__heading">Let&rsquo;s build something.</h1>
        <p class="contact__lead">
          Tell us what you are working on. The fastest way to start is a short call.
        </p>
      </header>

      <div class="contact__booking" data-reveal>
        <SchedulingButton />

        <div class="contact__embed">
          <iframe
            src={`${GOOGLE_CALENDAR_BOOKING_URL}?gv=true`}
            style="border:0; width:100%; height:640px; border-radius:16px;"
            title="Book a call with Sowerved Tech"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="contact__details" data-reveal>
        <p>
          <span class="contact__label">Email</span>
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
        <p>
          <span class="contact__label">Phone</span>
          <a href={`tel:${PHONE_HREF}`}>{PHONE}</a>
        </p>
        {socialLinks.length > 0 && (
          <p>
            <span class="contact__label">Social</span>
            {socialLinks.map((link, i) => (
              <>
                <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                {i < socialLinks.length - 1 && <span aria-hidden="true"> &middot; </span>}
              </>
            ))}
          </p>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact {
    padding-block: calc(var(--section-pad) * 0.6) var(--section-pad);
  }

  .contact__inner {
    max-width: 44em;
  }

  .contact__header {
    max-width: 40em;
  }

  .contact__heading {
    margin-top: var(--space-5);
  }

  .contact__lead {
    margin-top: var(--space-6);
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  .contact__booking {
    margin-top: var(--space-16);
  }

  .contact__embed {
    margin-top: var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    overflow: hidden;
  }

  .contact__embed iframe {
    display: block;
  }

  .contact__details {
    margin-top: var(--space-20);
    padding-top: var(--space-10);
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__details p {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    font-size: var(--fs-small);
  }

  .contact__details a {
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .contact__details a:hover {
    color: var(--accent);
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-subtle);
    min-width: 5em;
  }

  @media (max-width: 640px) {
    .contact__details p {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
