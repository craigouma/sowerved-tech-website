---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SchedulingButton from "../components/SchedulingButton.astro";
import TeamCard from "../components/TeamCard.astro";

const values = [
  {
    title: "Curiosity.",
    description: "We dig into the actual problem before we write a line of code.",
  },
  {
    title: "Ownership.",
    description: "We take responsibility for quality, from architecture to handover.",
  },
  {
    title: "Impact.",
    description:
      "We measure success by what the work does in the real world, not by output.",
  },
];

const team = [
  {
    name: "Craig",
    role: "CTO and Founder",
    photo: "/team/craig.webp",
    github: "https://github.com/craigouma",
    linkedin: "https://linkedin.com/in/craig-carlos-ouma",
  },
  {
    name: "Purity",
    role: "UI/UX Designer",
    photo: "/team/purity.webp",
    github: "https://github.com/purity-pyt",
    linkedin: "https://linkedin.com/in/purity-jeptoo",
  },
  {
    name: "Cedrick",
    role: "Backend Developer",
    photo: "/team/cedrick.webp",
    linkedin: "https://linkedin.com/in/cedrick-sango-27669923a",
  },
  {
    name: "Dennis",
    role: "Web3 Developer",
    photo: "/team/dennis.webp",
    github: "https://github.com/Dennis-DW",
    linkedin: "https://linkedin.com/in/dennis-wambua-321a47252",
  },
  {
    name: "Zacharia",
    role: "Frontend Developer",
    photo: "/team/zacharia.webp",
    linkedin: "https://linkedin.com/in/zacharia-wambugu-923164307",
  },
  {
    name: "Blair",
    role: "Full-Stack Software Engineer",
    linkedin: "https://www.linkedin.com/in/blairmuhindi/",
  },
];
---

<Layout
  title="Studio"
  description="Sowerved Tech is a small senior team building intelligent software, websites, data systems, and machine learning across three continents, from Nairobi, Kenya."
  path="/studio"
>
  <section class="intro">
    <div class="container intro__inner">
      <Eyebrow>Studio</Eyebrow>
      <h1 class="intro__heading">A small senior team building intelligent software.</h1>
      <p class="intro__lead">
        Sowerved Tech began with late night builds and grew into a studio shipping
        production software, websites, data systems, and machine learning across three
        continents. We stay small on purpose, so the people you meet are the people who
        do the work.
      </p>
    </div>
  </section>

  <Section eyebrow="How we operate" heading="What we value.">
    <div class="values-grid">
      {values.map((value) => (
        <div class="value-item" data-reveal>
          <h3 class="value-item__title">{value.title}</h3>
          <p class="value-item__desc">{value.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="The team" heading="The people behind the work." surface>
    <div class="team-grid">
      {team.map((member) => (
        <TeamCard
          name={member.name}
          role={member.role}
          photo={member.photo}
          github={member.github}
          linkedin={member.linkedin}
        />
      ))}
    </div>
  </Section>

  <section class="cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>Have something in mind?</h2>
        <p class="cta-band__line">Book a short call and tell us what you are building.</p>
      </div>
      <SchedulingButton />
    </div>
  </section>
</Layout>

<style>
  .intro {
    padding-block: calc(var(--section-pad) * 0.6) var(--section-pad);
  }

  .intro__inner {
    max-width: 42em;
  }

  .intro__heading {
    margin-top: var(--space-5);
    max-width: 16ch;
  }

  .intro__lead {
    margin-top: var(--space-6);
    font-size: var(--fs-body);
    color: var(--text-muted);
    max-width: 40em;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10) var(--space-8);
  }

  .value-item__title {
    font-weight: 500;
    font-size: var(--fs-body);
  }

  .value-item__desc {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10) var(--space-8);
  }

  .cta-band {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-block: var(--space-20);
  }

  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .cta-band__line {
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .values-grid {
      grid-template-columns: 1fr;
    }

    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .cta-band__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
