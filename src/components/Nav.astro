---
import SchedulingButton from "./SchedulingButton.astro";
import { NAV_LINKS } from "../config/site";

---

<header class="nav" id="site-nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo" aria-label="Sowerved Tech, home">
      <img class="nav__logo-img nav__logo-img--light" src="/brand/logo-dark.png" alt="Sowerved Tech" width="130" height="41" />
      <img class="nav__logo-img nav__logo-img--dark" src="/brand/logo-light.png" alt="Sowerved Tech" width="130" height="41" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav__actions">
      <button class="theme-toggle" aria-label="Switch to dark mode" type="button">
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
        </svg>
      </button>

      <SchedulingButton class="nav__cta" />

      <button
        class="nav__toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="nav-scrim" id="nav-scrim" hidden></div>

<div
  class="nav-drawer"
  id="nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  hidden
>
  <div class="nav-drawer__header">
    <button class="theme-toggle" aria-label="Switch to dark mode" type="button">
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2" />
        <path d="M12 20v2" />
        <path d="m4.93 4.93 1.41 1.41" />
        <path d="m17.66 17.66 1.41 1.41" />
        <path d="M2 12h2" />
        <path d="M20 12h2" />
        <path d="m6.34 17.66-1.41 1.41" />
        <path d="m19.07 4.93-1.41 1.41" />
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
      </svg>
    </button>

    <button class="nav-drawer__close" id="drawer-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="nav-drawer__links" aria-label="Mobile">
    <ul>
      {NAV_LINKS.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="nav-drawer__cta">
    <SchedulingButton class="nav-drawer__cta-btn" />
  </div>
</div>

<script>
  const toggle = document.getElementById("nav-toggle") as HTMLButtonElement | null;
  const drawer = document.getElementById("nav-drawer");
  const scrim = document.getElementById("nav-scrim");
  const closeBtn = document.getElementById("drawer-close");

  const focusableSelector = 'a[href], button:not([disabled])';
  let lastFocused: HTMLElement | null = null;

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function onKeydown(e: KeyboardEvent) {
    if (!drawer) return;
    if (e.key === "Escape") {
      closeDrawer();
      return;
    }
    if (e.key === "Tab") {
      const focusables = Array.from(
        drawer.querySelectorAll<HTMLElement>(focusableSelector)
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  function openDrawer() {
    if (!drawer || !scrim || !toggle) return;
    lastFocused = document.activeElement as HTMLElement;
    drawer.hidden = false;
    scrim.hidden = false;
    void drawer.offsetWidth;
    drawer.classList.add("is-open");
    scrim.classList.add("is-open");
    toggle.setAttribute("aria-expanded", "true");
    document.body.classList.add("nav-drawer-open");
    document.addEventListener("keydown", onKeydown);

    const focusables = drawer.querySelectorAll<HTMLElement>(focusableSelector);
    focusables[0]?.focus();
  }

  function closeDrawer() {
    if (!drawer || !scrim || !toggle) return;
    drawer.classList.remove("is-open");
    scrim.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
    document.body.classList.remove("nav-drawer-open");
    document.removeEventListener("keydown", onKeydown);

    const hide = () => {
      drawer.hidden = true;
      scrim.hidden = true;
    };

    if (prefersReducedMotion()) {
      hide();
    } else {
      drawer.addEventListener("transitionend", hide, { once: true });
    }

    (lastFocused ?? toggle).focus();
  }

  toggle?.addEventListener("click", openDrawer);
  scrim?.addEventListener("click", closeDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  drawer?.addEventListener("click", (e) => {
    const clicked = e.target as HTMLElement;
    if (clicked.closest("a, .qxCTlb")) closeDrawer();
  });

  const nav = document.getElementById("site-nav");
  const onScroll = () => {
    nav?.classList.toggle("nav--scrolled", window.scrollY > 8);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const themeToggles = document.querySelectorAll<HTMLButtonElement>(".theme-toggle");

  function currentTheme(): "light" | "dark" {
    return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  }

  function syncThemeToggles(theme: "light" | "dark") {
    themeToggles.forEach((btn) => {
      btn.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
      btn.setAttribute("aria-pressed", String(theme === "dark"));
    });

    const themeColorMeta = document.querySelector('meta[name="theme-color"]');
    themeColorMeta?.setAttribute("content", theme === "dark" ? "#0B0813" : "#FFFFFF");
  }

  syncThemeToggles(currentTheme());

  themeToggles.forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = currentTheme() === "dark" ? "light" : "dark";

      if (!prefersReducedMotion()) {
        document.documentElement.classList.add("theme-transition");
        window.setTimeout(() => {
          document.documentElement.classList.remove("theme-transition");
        }, 300);
      }

      if (next === "dark") {
        document.documentElement.setAttribute("data-theme", "dark");
      } else {
        document.documentElement.removeAttribute("data-theme");
      }

      try {
        localStorage.setItem("theme", next);
      } catch {
        // localStorage unavailable, theme just won't persist across reloads
      }

      syncThemeToggles(next);
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    border-bottom: 1px solid transparent;
    transition: background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }

  .nav--scrolled {
    background: var(--nav-bg-scrolled);
    border-bottom-color: var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-5);
  }

  .nav__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav__logo-img {
    height: 60px;
    width: auto;
  }

  .nav__logo-img--dark {
    display: none;
  }

  :global([data-theme="dark"]) .nav__logo-img--light {
    display: none;
  }

  :global([data-theme="dark"]) .nav__logo-img--dark {
    display: block;
  }

  .nav__links ul {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav__links a {
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .nav__links a:hover {
    color: var(--text);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .theme-toggle__icon--moon {
    display: block;
  }

  .theme-toggle__icon--sun {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__icon--moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__icon--sun {
    display: block;
  }

  .nav-drawer__header .theme-toggle {
    width: 36px;
    height: 36px;
  }

  .nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
  }

  .nav-scrim {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 60;
    opacity: 0;
    transition: opacity var(--duration-drawer) var(--ease-standard);
  }

  .nav-scrim.is-open {
    opacity: 1;
  }

  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 84vw);
    z-index: 61;
    background: var(--bg);
    border-left: 1px solid var(--border);
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    transform: translateX(100%);
    transition: transform var(--duration-drawer) var(--ease-standard);
  }

  .nav-drawer.is-open {
    transform: translateX(0);
  }

  .nav-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-10);
  }

  .nav-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
  }

  .nav-drawer__links ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .nav-drawer__links a {
    font-size: var(--fs-h3);
    color: var(--text);
    display: block;
    padding-block: var(--space-2);
  }

  .nav-drawer__cta {
    margin-top: auto;
    padding-top: var(--space-8);
  }

  .nav-drawer__cta :global(.nav-drawer__cta-btn) {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 720px) {
    .nav__links {
      display: none;
    }

    :global(.nav__cta) {
      display: none;
    }

    .nav__actions .theme-toggle {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-scrim,
    .nav-drawer {
      transition: none;
    }

    .nav-drawer {
      transform: translateX(100%);
    }

    .nav-drawer.is-open {
      transform: translateX(0);
    }
  }

  :global(body.nav-drawer-open) {
    overflow: hidden;
  }
</style>
