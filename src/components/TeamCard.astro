---
interface Props {
  name: string;
  role: string;
  photo?: string;
  github?: string;
  linkedin?: string;
}

const { name, role, photo, github, linkedin } = Astro.props;
const initials = name
  .split(" ")
  .map((part) => part[0])
  .join("")
  .slice(0, 2);
---

<article class="team-card" data-reveal>
  {photo ? (
    <img class="team-card__photo" src={photo} alt={name} loading="lazy" />
  ) : (
    <div class="team-card__placeholder" role="img" aria-label={`Photo pending for ${name}`}>
      <span>{initials}</span>
    </div>
  )}

  <h3 class="team-card__name">{name}</h3>
  <p class="team-card__role">{role}</p>

  {(github || linkedin) && (
    <div class="team-card__links">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`${name} on GitHub`}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.755-1.333-1.755-1.089-.744.084-.729.084-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.809 1.304 3.495.997.108-.775.42-1.305.763-1.605-2.665-.303-5.466-1.334-5.466-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .321.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
        </a>
      )}
      {linkedin && (
        <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${name} on LinkedIn`}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
      )}
    </div>
  )}
</article>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .team-card__photo,
  .team-card__placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    object-fit: cover;
    margin-bottom: var(--space-4);
    background: var(--surface-2);
  }

  .team-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
  }

  .team-card__placeholder span {
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    color: var(--text-subtle);
  }

  .team-card__name {
    font-weight: 500;
    font-size: var(--fs-body);
  }

  .team-card__role {
    font-size: var(--fs-small);
    color: var(--text-subtle);
  }

  .team-card__links {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .team-card__links a {
    color: var(--text-subtle);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .team-card__links a:hover {
    color: var(--accent);
  }
</style>
